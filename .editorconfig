# EditorConfig -- baseline whitespace rules any editor honors, so the formatters
# (ruff for Python, Prettier for frontend/) and reviewers aren't fighting stray
# CRLFs, tabs, or missing final newlines. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# pyproject.toml and the uv-generated uv.lock both use 4-space indent.
[*.toml]
indent_size = 4

# Markdown uses a trailing double-space for hard line breaks -- don't strip it.
[*.md]
trim_trailing_whitespace = false

# Test fixtures were copied verbatim from the old repo and are a parity contract
# (see CLAUDE.md) -- their hand style ("board" : [ ...) is intentional, leave it.
[tests/{cases,expected}/*.json]
indent_style = unset
indent_size = unset
