{
  "name": "Sudoku Solver (modern)",

  // Was a bare "image": "mcr.microsoft.com/devcontainers/python:3.12" until the
  // deploy tooling landed. The Dockerfile is FROM that same image and adds only
  // Packer (Terraform and the AWS CLI are official features below; Packer has
  // no maintained feature and no apt suite for this base's Debian release).
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Unlike the old repo's xenial-based devcontainer, this base image
  // (Debian 13/trixie, glibc 2.41) has no compatibility blocker against
  // the features below -- no manual static-binary/glibc-shim workarounds
  // needed, just the official features directly.
  "features": {
    // Lets frontend/ (npm install, vite) run directly in this same
    // container -- no sibling frontend container needed just to edit/build
    // the UI. Pinned to 26, matching frontend/Dockerfile and CI's
    // node-version -- "lts" floats (resolved to 24 when last checked), which
    // would silently diverge from what Docker/CI actually run the app on.
    // (26 isn't yet an LTS release as of this writing; matching Dockerfile's
    // Dependabot-proposed bump was a deliberate choice, not a default.)
    "ghcr.io/devcontainers/features/node:1": {
      "version": "26"
    },
    // Docker CLI + compose plugin, wired up against the host's own Docker
    // daemon (bind-mounts docker.sock, handles the non-root group
    // membership itself) -- lets `docker compose up`/`build` run from this
    // same terminal too, for testing the actual Dockerfiles/compose setup
    // rather than just the raw source. moby:false because this feature's
    // default (moby:true) installs Microsoft's "moby" packages, which
    // aren't published for Debian trixie ("moby-cli and related system
    // packages are not available in that distribution" -- confirmed by
    // actually trying to build this devcontainer); moby:false falls back
    // to the official Docker Engine apt repo instead, which does support
    // trixie.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    // Installs the claude CLI itself (Linux build -- the host's ~/.local/bin/claude
    // is a macOS binary and can't run in this container). Anthropic's own
    // feature, so it tracks new releases without a manual install script here.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // uv, for postCreateCommand below.
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    // gh CLI. Without it, git operations still work over HTTPS (VS Code's own
    // injected credential.helper forwards the host's GitHub auth as a
    // fallback), but that helper tries `gh auth git-credential` first and
    // logs a harmless "not found" to stderr on every fetch/push when it's
    // missing. Also needed directly for PR/issue work per CLAUDE.md.
    "ghcr.io/devcontainers/features/github-cli:1": {},

    // Deploy tooling for deploy/ (Terraform on EC2, see deploy/README.md).
    // Official feature -- also pulls in tflint. Packer is in the Dockerfile
    // instead (no maintained feature for it).
    "ghcr.io/devcontainers/features/terraform:1": {
      "tflint": "latest"
    },
    // AWS CLI, for `aws configure` / `aws ec2 stop-instances` etc. Credentials
    // are entered by the user at runtime (`aws configure`) into the ~/.aws
    // named volume below (survives rebuilds); nothing AWS-related is baked in.
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  // One extension per tool this repo actually uses:
  // - ms-python.python / ms-python.vscode-pylance: Python language support
  // - charliermarsh.ruff: linting/formatting (pyproject.toml-configured below)
  // - anthropic.claude-code: Claude Code's own VS Code extension
  // - redhat.vscode-yaml: schema validation/editing for docker-compose.yml and
  //   .github/workflows/ci.yml (VS Code's built-in YAML support has neither)
  // - ms-azuretools.vscode-containers: Dockerfile linting + compose support,
  //   for the Dockerfiles/docker-compose.yml this repo's docker-based workflow
  //   actually relies on
  // - tamasfe.even-better-toml: pyproject.toml editing/schema validation
  // - dbaeumer.vscode-eslint / esbenp.prettier-vscode: installed ahead of
  //   frontend/ actually having ESLint/Prettier config -- inert until then,
  //   see CLAUDE.md's note that frontend/ currently has no lint/format step
  // - hashicorp.terraform: syntax + validation for deploy/terraform/*.tf
  // - hashicorp.hcl: the non-Terraform HCL -- deploy/packer/*.pkr.hcl and the
  //   *.terraform.lock.hcl files (the terraform extension only claims *.tf).
  //   Defers to hashicorp.terraform on *.tf, so having both is fine.
  // - timonwong.shellcheck: inline shellcheck for scripts/*.sh and
  //   deploy/terraform/user_data.sh (shellcheck binary is in the Dockerfile)
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "anthropic.claude-code",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-containers",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "hashicorp.terraform",
        "hashicorp.hcl",
        "timonwong.shellcheck"
      ],
      // customizations.vscode.settings, not a checked-in .vscode/settings.json:
      // this path only exists inside the container (see containerEnv's
      // UV_PROJECT_ENVIRONMENT above), so it must only apply to the devcontainer
      // session -- a committed .vscode/settings.json would wrongly point a
      // host-opened VS Code window at this same nonexistent container path.
      // Without this, the Python extension won't auto-discover the relocated
      // venv (it only scans workspace-relative .venv/venv), silently falling
      // back to the base image's system Python -- which has none of this
      // project's dependencies installed -- for both running and debugging.
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python"
      }
    }
  },

  // Installs this project (editable) plus its dev extras (pytest, httpx2)
  // from uv.lock, and frontend/'s npm deps, so both are immediately runnable.
  //
  // The chown fixes a real bug hit in practice: Docker creates a fresh named
  // volume's mountpoint owned by root:root, but remoteUser here is vscode
  // (uid 1000, not in the root group) -- so without this, `claude /login`
  // inside the container would appear to complete in the browser but silently
  // fail to write its credentials file into the (root-owned, read-only-to-
  // vscode) mounts entry below, surfacing later as "Failed to retrieve auth
  // status after login". Same reasoning applies to the gh-config and aws
  // volumes -- without the chown, `gh auth login` / `aws configure` would hit
  // the same silent write failure into a root-owned ~/.config/gh / ~/.aws.
  // Runs once per container creation (idempotent, so harmless on rebuilds
  // against already-fixed volumes too).
  //
  // The gh symlink works around this base image's apt-based install (via the
  // github-cli feature above) landing at /usr/bin/gh -- VS Code's own git
  // credential helper shells out to gh via the hardcoded path
  // /usr/local/bin/gh rather than resolving it through PATH, so without this
  // every git fetch/push logs "/usr/local/bin/gh: not found" to stderr (the
  // fetch/push itself still succeeds via the helper's other fallback).
  "postCreateCommand": "sudo ln -sf \"$(command -v gh)\" /usr/local/bin/gh && sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.config/gh /home/vscode/.aws && uv sync --extra dev && npm install --prefix frontend",

  // containerEnv, not remoteEnv: remoteEnv is only injected into sessions VS
  // Code itself starts (its integrated terminal, postCreateCommand, tasks) --
  // it does *not* apply to a plain `docker exec`/`ssh` shell in the same
  // container. UV_PROJECT_ENVIRONMENT being remoteEnv-only was a real bug
  // here, not just a style choice: found by exec-ing in directly and running
  // `uv run pytest`, which -- with the var unset in that shell -- created a
  // *new* .venv straight in this bind-mounted workspace, silently deleting
  // the host's own (macOS) .venv that happened to be sitting at that same
  // path first. containerEnv applies everywhere uniformly, so that can't
  // happen regardless of how a shell gets into the container.
  "containerEnv": {
    // uv normally creates .venv next to pyproject.toml -- but that's this
    // bind-mounted workspace, so it'd land in the same ./.venv a host
    // checkout uses for its own (macOS, not Linux) venv. Relocating it
    // container-side avoids one platform's venv clobbering the other's.
    // `uv run`/`uv sync` both honor this automatically, no PATH change
    // needed to use them.
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    // Lets a first `claude` run in the container skip interactive login,
    // if the host shell has one of these set (empty/unset on the host is
    // fine -- VS Code substitutes an empty string, not an error). Get a
    // token via `claude setup-token` on the host; the macOS Keychain entry
    // the host CLI actually uses can't be read from inside this container.
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  },

  // Named volumes (not host bind mounts) for the container's own ~/.claude
  // and ~/.config/gh -- keeps Claude Code's settings/memory/auth and gh's
  // own login stable across rebuilds, without live-sharing (and racing
  // with) the host's actual versions of either, which a real host machine
  // also has open at the same time. gh's auth doesn't come from a host env
  // var (GH_TOKEN, CLAUDE_CODE_OAUTH_TOKEN-style) on purpose: this devcontainer
  // is launched from the VS Code GUI (Dock/Finder), whose process doesn't
  // source ~/.bashrc/~/.zshrc, so a host shell-profile var wouldn't reach
  // ${localEnv:...} substitution here without extra host-side launchd setup.
  // Run `gh auth login` once inside the container instead -- it persists in
  // this volume across every rebuild from then on. Same pattern for ~/.aws:
  // run `aws configure` once inside the container (see deploy/README.md) and
  // the credentials persist across rebuilds without touching a host ~/.aws.
  // The volume also gives postCreateCommand's chown a real (Docker-created,
  // root-owned) mountpoint to fix up -- without it the chown -R would error
  // on a missing path and abort the rest of postCreateCommand.
  "mounts": [
    "source=claude-code-config-sudoku-solver-modern,target=/home/vscode/.claude,type=volume",
    "source=gh-config-sudoku-solver-modern,target=/home/vscode/.config/gh,type=volume",
    "source=aws-config-sudoku-solver-modern,target=/home/vscode/.aws,type=volume"
  ],

  // uvicorn's default port, and Vite's dev server port
  "forwardPorts": [8000, 3000],

  "remoteUser": "vscode"
}
