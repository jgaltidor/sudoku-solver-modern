.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# frontend/ (Vite + React)
frontend/node_modules/
frontend/dist/

# Claude Code local settings (machine-specific; .claude/settings.json, if
# added later, is project config and should still be tracked)
.claude/settings.local.json
.claude/*.tmp.*

# deploy/ (Terraform + Packer). Configs and .terraform.lock.hcl are tracked;
# state, local var files, and the provider plugin cache are not.
deploy/**/.terraform/
deploy/**/*.tfstate
deploy/**/*.tfstate.*
deploy/**/*.tfvars
!deploy/**/*.tfvars.example
deploy/**/crash.log
deploy/**/crash.*.log
deploy/packer/*.pkrvars.hcl
deploy/packer/manifest.json
