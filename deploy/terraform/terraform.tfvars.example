# Everything has a sensible default now -- terraform.tfvars is OPTIONAL.
# Copy this file to terraform.tfvars only if you want to override something.
# terraform.tfvars is gitignored.
#
#   cp terraform.tfvars.example terraform.tfvars

# Optional overrides (defaults shown):
# aws_region       = "us-east-1"
# cpu_architecture = "x86_64"          # "arm64" if you switch instance_type to a t4g.*
# instance_type    = "t3.micro"        # free-tier eligible
# docker_image     = "docker.io/jgaltidor/sudoku-solver-modern:latest"
# ami_id           = ""                # set to a Packer-baked AMI to skip boot-time Docker install
